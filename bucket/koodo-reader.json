{
    "version": "2.4.3",
    "homepage": "https://www.koodoreader.com",
    "description": "All-in-one ebook reader.",
    "license": "AGPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://dl.koodoreader.com/v2.4.3/Koodo-Reader-2.4.3-x64.exe#/dl.7z",
            "hash": "sha512:2481e716f243a30b997d732b6c4d77c5f1900c054c9a97d9f27e38e8eebb60d75bf6521e9e8cb4dcbc0572f582ac43ce4a88ff7458ecfb44e572e18d79c5af3e"
        },
        "32bit": {
            "url": "https://dl.koodoreader.com/v2.4.3/Koodo-Reader-2.4.3-ia32.exe#/dl.7z",
            "hash": "sha512:08ddaae4514cb148d162ff626052d48e6265e02259a52e0b8120804f1398cf3ffdc209e56cd735c40db8627969d7653110bbbe4456f304b7c845152167eb1d8f"
        },
        "arm64": {
            "url": "https://dl.koodoreader.com/v2.4.3/Koodo-Reader-2.4.3-arm64.exe#/dl.7z",
            "hash": "sha512:3dc52c2ffd83d2e710ec520243ce093dac7f8dedc4c38260789ebed0f3ff8f99f4b09ed80165b9deeaf7868926bd0ace5e51a07d2416b8fbd78e7a5eab1d8b81"
        }
    },
    "installer": {
        "script": [
            "Remove-Item \"$dir\\resources\" -Recurse -Force -ErrorAction SilentlyContinue",
            "Get-Item \"$dir\\`$PLUGINSDIR\\app*.7z\" | Expand-7zipArchive -DestinationPath \"$dir\"",
            "Remove-Item \"$dir\\`$*\" -Force -Recurse"
        ]
    },
    "post_install": [
        "$koodo_exe = \"$dir\\Koodo Reader.exe\".Replace('\\', '\\\\')",
        "$extensions = '.epub', '.mobi', '.azw', '.azw3', '.fb2', '.pdf', '.djvu', '.cbr', '.cbz', '.cbt', '.cb7', '.txt', '.md', '.docx', '.rtf'",
        "$content = @(",
        "    'Windows Registry Editor Version 5.00'",
        "    ''",
        "    '[HKEY_CURRENT_USER\\Software\\Classes\\Applications\\Koodo Reader.exe]'",
        "    '\"FriendlyAppName\"=\"Koodo Reader\"'",
        "    ''",
        "    '[HKEY_CURRENT_USER\\Software\\Classes\\Applications\\Koodo Reader.exe\\shell\\open\\command]'",
        "    ('@=\"' + $koodo_exe + '\" \"%1\"')",
        "    ''",
        "    '[HKEY_CURRENT_USER\\Software\\Classes\\Applications\\Koodo Reader.exe\\DefaultIcon]'",
        "    ('@=\"' + $koodo_exe + ',0\"')",
        "    ''",
        "    '[HKEY_CURRENT_USER\\Software\\Classes\\Applications\\Koodo Reader.exe\\SupportedTypes]'",
        ")",
        "foreach ($ext in $extensions) { $content += ('\"' + $ext + '\"=\"\"') }",
        "Set-Content \"$dir\\install-context.reg\" $content",
        "reg import \"$dir\\install-context.reg\""
    ],
    "pre_uninstall": [
        "Remove-Item \"HKCU:\\Software\\Classes\\Applications\\Koodo Reader.exe\" -Recurse -Force -ErrorAction SilentlyContinue"
    ],
    "shortcuts": [
        [
            "Koodo Reader.exe",
            "Koodo Reader"
        ]
    ],
    "checkver": {
        "url": "https://koodoreader.com/en/download",
        "regex": "Stable Version.*?(?<version>[\\d.]+)<"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://dl.koodoreader.com/v$version/Koodo-Reader-$version-x64.exe#/dl.7z"
            },
            "32bit": {
                "url": "https://dl.koodoreader.com/v$version/Koodo-Reader-$version-ia32.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://dl.koodoreader.com/v$version/Koodo-Reader-$version-arm64.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?sm)$basename.*?sha512:\\s+$base64"
        }
    }
}
